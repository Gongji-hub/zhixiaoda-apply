{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["chrome"],
    "paths": {
      "@src/*": ["./chrome-extension/src/*"],
      "@extension/i18n": ["./packages/i18n/lib/i18n-prod.ts"],
      "@extension/storage": ["./packages/storage/lib/settings/generalSettings.ts"],
      "@extension/storage/lib/chat": ["./packages/storage/lib/chat/index.ts"]
    }
  },
  "include": ["chrome-extension/src"]
}
